# If you change this file, run 'update-grub' afterwards to update
# /boot/grub/grub.cfg.
# For full documentation of the options in this file, see:
#   info -f grub -n 'Simple configuration'

# Настройки по умолчанию и таймаута
GRUB_DEFAULT="Debian"
GRUB_TIMEOUT="7"
GRUB_SAVEDEFAULT="false"
GRUB_DISTRIBUTOR="`lsb_release -i -s 2> /dev/null || echo Debian`"

# Параметры ядра Linux
GRUB_CMDLINE_LINUX_DEFAULT="quiet loglevel=0 splash"
GRUB_CMDLINE_LINUX=""

# Настройки для мультизагрузки
# Включен os-prober для обнаружения других ОС (Windows, Ubuntu)
GRUB_DISABLE_OS_PROBER="false"

# Настройки темы и графики
GRUB_THEME="/boot/grub/themes/dedsec/theme.txt"
GRUB_GFXMODE="1920x1080"
GRUB_GFXPAYLOAD_LINUX="keep"

# Настройки меню
# Скрыть пункты восстановления (можно раскомментировать для отображения)
#GRUB_DISABLE_RECOVERY="true"

# Настройки терминала
#GRUB_TERMINAL="console"

# Дополнительные настройки
#GRUB_BADRAM="0x01234567,0xfefefefe,0x89abcdef,0xefefefef"
#GRUB_DISABLE_LINUX_UUID="true"
#GRUB_INIT_TUNE="480 440 1"

# Настройки для скрытия пунктов меню (если нужно)
# Скрыть пункты восстановления
GRUB_DISABLE_RECOVERY="true"

# Настройки для улучшения производительности
GRUB_TIMEOUT_STYLE="menu"
